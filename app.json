{
  "expo": {
    "name": "MaslogCare",
    "slug": "maslogCare",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/maslogicon.png",
    "scheme": "maslogcare",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.maslogcare.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/maslogicon.png",
        "monochromeImage": "./assets/images/maslogicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "name": "MaslogCare",
      "output": "static",
      "favicon": "./assets/images/maslogicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/maslogicon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/maslogicon.png",
          "color": "#0284C7",
          "defaultChannel": "maslogcare-default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f8524601-75ac-49b3-883d-49c259a01305"
      }
    },
    "owner": "kapenx",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f8524601-75ac-49b3-883d-49c259a01305"
    }
  }
}
