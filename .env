 #EXPO_PUBLIC_API_URL=http://10.59.91.103:5000/api       

 EXPO_PUBLIC_API_URL=http://172.20.10.7:5000/api     

 #EXPO_PUBLIC_API_URL=http://192.168.8.51:5000/api

# Locality shown on the registration form. Must match the backend's
# RESIDENT_* values — the server overrides the barangay on every registration
# regardless of what the client sends.
EXPO_PUBLIC_RESIDENT_BARANGAY=Maslog
EXPO_PUBLIC_RESIDENT_CITY_MUNICIPALITY=Legazpi City
EXPO_PUBLIC_RESIDENT_PROVINCE=Albay

# Fallback source for the Expo push token's project id. `eas init` normally writes
# extra.eas.projectId into app.json; set this only if you build without that entry.
# EXPO_PUBLIC_EAS_PROJECT_ID=
