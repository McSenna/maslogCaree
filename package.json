{
  "name": "maslogcare",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint src app",
    "backend": "npm run dev --prefix ../backend",
    "mobile": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android:local": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"src/**/__tests__/*.test.ts\"",
    "test:e2e": "node --test \"e2e/**/*.e2e.mjs\"",
    "deploy": "npx expo export -p web --clear && wrangler deploy",
    "preview": "npx expo export -p web --clear && wrangler dev"
  },
  "dependencies": {
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "axios": "^1.13.6",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.49.0",
    "nativewind": "^4.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest-axe": "^11.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-refresh": "^0.14.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.148.0"
  },
  "private": true
}
