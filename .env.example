# Development API base URL. "/api" is appended if missing. Keep localhost:
# phones and the browser substitute the dev server's address automatically.
# Production builds read .env.production instead.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Locality shown on the registration form. Must match the backend's RESIDENT_* values.
EXPO_PUBLIC_RESIDENT_BARANGAY=Maslog
EXPO_PUBLIC_RESIDENT_CITY_MUNICIPALITY=Legazpi City
EXPO_PUBLIC_RESIDENT_PROVINCE=Albay

# Optional fallback for the Expo push token's project id (normally set by `eas init` in app.json).
# EXPO_PUBLIC_EAS_PROJECT_ID=
